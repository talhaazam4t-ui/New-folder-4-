{
  "talox-quality-gate": {
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|replace_file_content|write_to_file|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/verify-stack.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./scripts/verify-stack.mjs"
      }
    ]
  }
}
