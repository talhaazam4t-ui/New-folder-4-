# ==============================================================================
# Talox Tech Stream — Environment Configuration Template
# Copy this file to .env and provide your secrets for production or testing.
# DO NOT commit the .env file containing real secrets to version control.
# ==============================================================================

# Application Settings
APP_NAME="Talox Tech Stream"
APP_ENV=development # development | staging | production
APP_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-key-in-production
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Sole Administrator & Session Configuration
SUPER_ADMIN_EMAILS=["talhazam4@gmail.com","talhaazam4t@gmail.com"]
SESSION_EXPIRE_DAYS=30
SUPPORT_WHATSAPP_NUMBER=03238300330

# URLs & CORS
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Supabase PostgreSQL & Auth
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-keep-server-side-only
SUPABASE_DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# AI Provider Configuration (Centralized OpenRouter with Smart Routing)
AI_PROVIDER=openrouter # openrouter | mock
AI_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_DEFAULT_FAST_MODEL=google/gemini-flash-1.5 # Or openai/gpt-4o-mini
AI_DEFAULT_REASONING_MODEL=anthropic/claude-3.5-sonnet

# Cost Protection, Rate Limiting & Circuit Breaker
RATE_LIMIT_AGENT_RPM=20
RATE_LIMIT_DEFAULT_RPM=60
CIRCUIT_BREAKER_MAX_FAILURES=3
CIRCUIT_BREAKER_COOLDOWN_SECONDS=300
DEFAULT_TENANT_DAILY_TOKEN_BUDGET=100000

# WhatsApp Cloud API & Meta Embedded Signup
WHATSAPP_PROVIDER=meta # meta | mock
WHATSAPP_ACCESS_TOKEN=your-meta-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-custom-webhook-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret
META_APP_ID=your-meta-app-id
META_CONFIG_ID=your-meta-embedded-signup-configuration-id

# Payment & Billing Rails
PAYMENT_PROVIDER=manual # manual | stripe | local_rails
PAYMENT_SECRET_KEY=your-payment-secret-key
PAYMENT_WEBHOOK_SECRET=your-payment-webhook-secret

# Redis (Optional in Phase 0/1; database-backed queue used by default)
REDIS_URL=redis://localhost:6379/0
