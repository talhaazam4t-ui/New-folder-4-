# ==============================================================================
# Teloxtech SaaS — Production & Local Environment Configuration Template
# Copy this file to .env and provide your secrets for production or testing.
# DO NOT commit the .env file containing real secrets to version control.
# ==============================================================================

# --- [1] Core Application & Server Settings ---
APP_NAME="Talox Tech Stream"
APP_ENV=development # development | staging | production
APP_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-key-in-production
DEBUG=true
PORT=8000
HOST=0.0.0.0

# --- [2] Sole Administrator & Session Management ---
# Exclusive Super Administrator email (strictly verified server-side)
SUPER_ADMIN_EMAILS=["talhaazam4t@gmail.com"]
SESSION_EXPIRE_DAYS=30
SUPPORT_WHATSAPP_NUMBER=03238300330

# --- [3] URLs, Frontend & CORS ---
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
NEXT_PUBLIC_APP_NAME="Talox Tech Stream"
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# --- [4] Supabase PostgreSQL, Authentication & RLS ---
# Primary Project: pmmduhflikdvddzpgwsi (eu-west-1)
SUPABASE_URL=https://pmmduhflikdvddzpgwsi.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SUPABASE_URL=https://pmmduhflikdvddzpgwsi.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-keep-server-side-only
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-from-api-settings
# Required in production: asynchronous pooled PostgreSQL connection string
SUPABASE_DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@db.pmmduhflikdvddzpgwsi.supabase.co:5432/postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- [5] DeepSeek AI Provider (Exclusive AI Provider) ---
# API Base URL: https://api.deepseek.com
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Lightweight model with tool-calling and JSON mode support
AI_DEFAULT_FAST_MODEL=deepseek-chat
# Powerful chain-of-thought reasoning model (tool-calling and JSON mode disabled)
AI_DEFAULT_REASONING_MODEL=deepseek-reasoner

# --- [6] Cost Protection, Token Budgets & Rate Limiting ---
RATE_LIMIT_AGENT_RPM=20
RATE_LIMIT_DEFAULT_RPM=60
CIRCUIT_BREAKER_MAX_FAILURES=3
CIRCUIT_BREAKER_COOLDOWN_SECONDS=300
DEFAULT_TENANT_DAILY_TOKEN_BUDGET=100000

# --- [7] WhatsApp Business Cloud API & Meta Webhooks ---
# Meta Graph API v21.0
WHATSAPP_PROVIDER=mock # meta | mock
WHATSAPP_ACCESS_TOKEN=your-meta-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-business-account-id
WHATSAPP_APP_SECRET=your-meta-app-secret-for-hmac-sha256-verification
WHATSAPP_VERIFY_TOKEN=talox_verify_token
META_APP_ID=your-meta-app-id
META_CONFIG_ID=your-meta-embedded-signup-configuration-id

# --- [8] Google OAuth, Places API, Apollo Free Tier, Gemini & Resend ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/onboarding
GOOGLE_PLACES_API_KEY=your-google-places-api-key
APOLLO_API_KEY=your-apollo-free-tier-api-key
GEMINI_API_KEY=your-gemini-api-key
RESEND_API_KEY=your-resend-api-key

# --- [9] Payment & Billing Rails (Server-Side Only — Never expose in NEXT_PUBLIC_*) ---
PAYMENT_PROVIDER=lemonsqueezy # manual | lemonsqueezy | payfast | safepay | stripe
LEMONSQUEEZY_TEST_MODE=true
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_API_KEY=your-lemonsqueezy-api-key-server-side-only
LEMONSQUEEZY_WEBHOOK_SECRET=your-lemonsqueezy-webhook-signing-secret-max-40-chars
LEMONSQUEEZY_VARIANT_ID_STARTER=
LEMONSQUEEZY_VARIANT_ID_GROWTH=
LEMONSQUEEZY_VARIANT_ID_ENTERPRISE=
LEMONSQUEEZY_CHECKOUT_URL_STARTER=
LEMONSQUEEZY_CHECKOUT_URL_GROWTH=
LEMONSQUEEZY_CHECKOUT_URL_ENTERPRISE=
PAYMENT_SECRET_KEY=your-payment-secret-key
PAYMENT_WEBHOOK_SECRET=your-payment-webhook-secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=
SAFEPAY_API_KEY=
SAFEPAY_WEBHOOK_SECRET=
CRON_SECRET=change-this-cron-secret

# --- [10] Office Receptionist — AI Voice Agent (Retell AI, Telnyx, Cal.com) ---
RETELL_API_KEY=your-retell-api-key
RETELL_BASE_URL=https://api.retellai.com
RETELL_WEBHOOK_SECRET=your-retell-webhook-secret
TELNYX_API_KEY=your-telnyx-api-v2-key
TELNYX_CONNECTION_ID=
TELNYX_DEFAULT_NUMBER=
TELNYX_DEFAULT_COUNTRY=US
CALCOM_API_KEY=your-calcom-api-key
CALCOM_BASE_URL=https://api.cal.com/v2

# --- [11] Task Queue / Redis (Optional in local dev) ---
REDIS_URL=redis://localhost:6379/0
